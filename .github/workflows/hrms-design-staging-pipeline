name: hrms-design-staging-pipeline

# When this action will be executed
on:
  # Automatically trigger it when detected changes in repo
  push:
    branches: 
      [ design-staging ]
    paths:
    - '**'
    - '.github/workflows/hrms-design-staging-pipeline.yml'

  # Allow manual trigger 
  workflow_dispatch:      

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    permissions: 
      id-token: write #This is required for requesting the OIDC JWT Token
      contents: read #Required when GH token is used to authenticate with private repo

    steps:
      - name: Checkout to the branch
        uses: actions/checkout@v2

      - name: Azure Login
        uses: azure/login@v1
        with:
          client-id: ${{ secrets.HRMSDESIGNSTAGINGFE_AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.HRMSDESIGNSTAGINGFE_AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.HRMSDESIGNSTAGINGFE_AZURE_SUBSCRIPTION_ID }}

      - name: Build and push container image to registry
        uses: azure/container-apps-deploy-action@v2
        with:
          appSourcePath: ${{ github.workspace }} 
          registryUrl: hrmsacr.azurecr.io
          registryUsername: ${{ secrets.HRMSDESIGNSTAGINGFE_REGISTRY_USERNAME }}
          registryPassword: ${{ secrets.HRMSDESIGNSTAGINGFE_REGISTRY_PASSWORD }}
          containerAppName: hrms-design-staging-fe
          resourceGroup: HRMS-AZURE
          imageToBuild: hrmsacr.azurecr.io/hrms-design-staging-fe:${{ github.sha }}
          _buildArgumentsKey_: |
            _buildArgumentsValues_
